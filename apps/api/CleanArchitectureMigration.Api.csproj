    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Storage\**" />
    <Content Remove="Storage\**" />
    <EmbeddedResource Remove="Storage\**" />
    <None Remove="Storage\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\packages\migration-contracts\CleanArchitectureMigration.Contracts.csproj" />
    <ProjectReference Include="..\..\packages\architecture-rules\CleanArchitectureMigration.ArchitectureRules.csproj" />
    <ProjectReference Include="..\..\services\migration-orchestrator\CleanArchitectureMigration.Orchestrator.csproj" />
    <ProjectReference Include="..\..\services\dotnet-worker\CleanArchitectureMigration.DotNetWorker.csproj" />
    <ProjectReference Include="..\..\services\java-worker\CleanArchitectureMigration.JavaWorker.csproj" />
  </ItemGroup>

</Project>
