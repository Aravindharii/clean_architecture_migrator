{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MigrationPlan",
  "description": "Schema for structured Clean Architecture migration plan generated by AI and verified by human developer",
  "type": "object",
  "required": [
    "planId",
    "jobId",
    "planVersion",
    "sourceHash",
    "targetArchitecture",
    "summary",
    "overallRisk",
    "operations"
  ],
  "properties": {
    "planId": { "type": "string", "format": "uuid" },
    "jobId": { "type": "string", "format": "uuid" },
    "planVersion": { "type": "integer", "minimum": 1 },
    "sourceHash": { "type": "string" },
    "targetArchitecture": { 
      "type": "string", 
      "enum": ["dotnet-clean-architecture", "java-clean-architecture"] 
    },
    "summary": { "type": "string" },
    "overallRisk": { "type": "string", "enum": ["low", "medium", "high"] },
    "estimatedEffortHours": { "type": "number", "minimum": 0 },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "operationId",
          "sequence",
          "type",
          "description",
          "confidence",
          "risk",
          "requiresApproval"
        ],
        "properties": {
          "operationId": { "type": "string" },
          "sequence": { "type": "integer" },
          "type": {
            "type": "string",
            "enum": [
              "CreateProjectOrModule",
              "MoveFile",
              "RenameNamespaceOrPackage",
              "UpdateProjectReferences",
              "ExtractInterface",
              "UpdateDependencyInjection",
              "CreateApplicationUseCase",
              "ProposeRepositoryAbstraction",
              "RewriteReferences",
              "RemoveLegacyProject",
              "FlagForManualRefactoring",
              "AddArchitectureValidationRules"
            ]
          },
          "sourcePath": { "type": ["string", "null"] },
          "destinationPath": { "type": ["string", "null"] },
          "parameters": { 
            "type": "object",
            "additionalProperties": true
          },
          "reason": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "risk": { "type": "string", "enum": ["low", "medium", "high"] },
          "prerequisites": {
            "type": "array",
            "items": { "type": "string" }
          },
          "requiresApproval": { "type": "boolean" },
          "isApproved": { "type": "boolean" },
          "manualReviewRequired": { "type": "boolean" },
          "codeDiffPreview": { "type": ["string", "null"] }
        }
      }
    }
  }
}
